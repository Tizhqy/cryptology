# Copy this file to .env for local development.
# Never commit the copied file or real secrets.

APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Lab-only target allowlist
LAB_ALLOWED_TARGETS=127.0.0.1,localhost

# Security profile: secure | insecure | proxy
SECURITY_PROFILE=secure

# Optional local proxy for Burp or another lab proxy
HTTP_PROXY=
HTTPS_PROXY=

# Development-only identifiers. Use a secret manager for real deployments.
LAB_SIGNING_KEY_ID=local-lab-only
