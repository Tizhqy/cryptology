{
  "application": {
    "name": "cryptology-server",
    "environment": "development",
    "log_level": "INFO"
  },
  "node": {
    "role": "server",
    "bind_host": "0.0.0.0",
    "bind_port": 5050
  },
  "security": {
    "mode": "secure",
    "key_exchange": "ecdh",
    "data_encryption": {
      "algorithm": "AES-128",
      "mode": "GCM",
      "implementation": "library"
    },
    "manual_aes_enabled": false
  },
  "transfer": {
    "max_file_size_bytes": 5242880,
    "chunk_size_bytes": 4096,
    "allowed_extensions": [".pdf"]
  },
  "measurement": {
    "enabled": true,
    "repeat_count": 15,
    "output_directory": "artifacts/measurements"
  }
}
